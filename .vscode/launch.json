{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Compiler",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/holangc",
      "console": "integratedTerminal",
      "args": [
        "${input:path}",
      ]
    },
    {
      "name": "Compiler [debug]",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/holangc",
      "console": "integratedTerminal",
      "args": [
        "--debug",
        "${input:path}",
      ]
    },
    {
      "name": "Compiler [run]",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/holangc",
      "console": "integratedTerminal",
      "args": [
        "--run",
        "${input:path}",
      ]
    },
    {
      "name": "Compiler [run/debug]",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/holangc",
      "console": "integratedTerminal",
      "args": [
        "--run",
        "--debug",
        "${input:path}",
      ]
    },
    {
      "name": "VM",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/holang",
      "console": "integratedTerminal",
      "args": [
        "${input:path}",
      ]
    },
    {
      "name": "VM [debug]",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/holang",
      "console": "integratedTerminal",
      "args": [
        "--debug",
        "${input:path}",
      ]
    },
  ],
  "inputs": [
    {
      "id": "path",
      "type": "promptString",
      "description": "file path",
      "default": ""
    }
  ]
}